# Copy to .env for local development. See README.md and docs/blueprint/01 §5.
# To connect real social accounts locally, the URLs below and R2_ENDPOINT point at a Cloudflare tunnel
# (README.md, "Connecting real social accounts in development").

# App
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_SHORT_URL="http://localhost:3000"
NUXT_PUBLIC_MEDIA_URL="http://localhost:9090/socialz-media"
NUXT_PUBLIC_APP_ENV="development"

# Database (runtime code uses the pooled URL; migrations use the direct URL, CI only)
DATABASE_URL="postgresql://socialz:socialz@localhost:5432/socialz"
DATABASE_URL_DIRECT="postgresql://socialz:socialz@localhost:5432/socialz"
DB_DRIVER="pg"
DB_POOL_MAX="3"

# Auth
BETTER_AUTH_SECRET="dev-only-change-me-dev-only-change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secrets at rest
SETTINGS_SECRET="dev-only-settings-secret-change-me"

# Jobs (docs/blueprint/15)
CRON_SECRET="dev-cron-secret"
INTERNAL_SIGNING_SECRET="dev-internal-signing-secret"
JOBS_TIME_BUDGET_MS="45000"
JOBS_FANOUT_MAX="4"

# Media processor (docs/blueprint/19 §5)
MEDIA_PROCESSOR_DRIVER="http"
# Dev: `npm run media:dev` runs the processor locally with your ffmpeg.
MEDIA_PROCESSOR_URL="http://localhost:3200"
MEDIA_PROCESSOR_SECRET="dev-media-secret"

# Meta (later milestones)
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v25.0"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

# Storage (R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID="dev"
R2_SECRET_ACCESS_KEY="dev"
R2_BUCKET="socialz-media"
# Dev only: point the R2 driver at the local S3 mock. Empty in production (https://<account>.r2.cloudflarestorage.com).
R2_ENDPOINT="http://localhost:9090"

# Email over SMTP (docs/blueprint/11 §4). Used when the Resend key in /admin → Pengaturan is empty and the
# back-office "Server SMTP" field is empty too. 587 = STARTTLS, 465 = TLS; port 25 is blocked on most hosts.
# Dev: the Mailpit container listens on 1025 (no auth); leave SMTP_HOST empty to use MAILPIT_URL's HTTP API instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Dev / test
MAILPIT_URL="http://localhost:8025"
# "fake" simulates Instagram/Threads/Facebook until Meta app IDs exist; "real" calls Meta.
ADAPTER_MODE="fake"
SEED_SUPERADMIN_EMAIL="admin@socialz.local"
SEED_SUPERADMIN_PASSWORD="admin12345"

# Storage (Vercel Blob): a public Blob store. A token switches media storage from R2 to Vercel Blob;
# STORAGE_DRIVER="r2" or "vercel-blob" forces one. NUXT_PUBLIC_MEDIA_URL and R2_* are then unused.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
